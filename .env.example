# 阿里云百炼 / DashScope API Key（勿提交真实密钥）
# 获取：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-你的密钥

# 文本模型（戏曲剧本三页）
DASHSCOPE_CHAT_MODEL=qwen3.5-flash

# 图像模型（每页剧照）
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro

# 可选：地域端点（默认北京）
# DASHSCOPE_CHAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_IMAGE_BASE=https://dashscope.aliyuncs.com/api/v1

# 剧照分辨率（16:9 推荐 1472*1104；总像素需在 512×512～2048×2048 之间）
DASHSCOPE_IMAGE_SIZE=1472*1104

# 是否开启提示词智能改写（易增加「梦幻/柔光」导致发白，建议 false）
DASHSCOPE_PROMPT_EXTEND=false

# 开发调试：true 时「粤剧·牡丹亭·杜丽娘」直接用 assets/storybook-test/mudanting 缓存
# 先运行 npm run fixtures:mudanting 生成三张测试图
DASHSCOPE_USE_FIXTURES=false
